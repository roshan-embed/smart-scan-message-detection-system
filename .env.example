# Database Configuration
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_scam_detection

# Fallback to sqlite if MySQL server is not running during local quick test
ENABLE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=smart_scam_detection.db

# Security & Session
SECRET_KEY=smart-scam-detection-secure-key-2026-distilbert-mvc
SESSION_COOKIE_NAME=scam_detect_session
PERMANENT_SESSION_LIFETIME_HOURS=24
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# App Environment
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
